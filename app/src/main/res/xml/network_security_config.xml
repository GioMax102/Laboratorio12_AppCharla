<?xml version="1.0" encoding="utf-8"?>
<!--
  Permite tráfico HTTP/WebSocket no encriptado (cleartext) para desarrollo local
  tanto en el emulador (10.0.2.2) como en dispositivos físicos conectados
  a la red local (ej. 192.168.x.x o 10.x.x.x).
-->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
        </trust-anchors>
    </base-config>
</network-security-config>
